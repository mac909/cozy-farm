{
  "name": "cozy-farm",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node --import tsx server/src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "farm:up": "docker compose up -d --build",
    "farm:down": "docker compose down",
    "farm:logs": "docker compose logs -f",
    "farm:backup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup-farm.ps1",
    "farm:restore": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/restore-farm.ps1"
  },
  "dependencies": {
    "@colyseus/schema": "^3.0.0",
    "@colyseus/ws-transport": "~0.16.0",
    "colyseus": "~0.16.0",
    "colyseus.js": "~0.16.0",
    "express": "^4.21.2",
    "phaser": "^3.90.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
